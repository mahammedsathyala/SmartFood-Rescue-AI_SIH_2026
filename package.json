{
  "name": "sih-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && npm --prefix functions run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "login": "firebase login",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions",
    "deploy:all": "npm run build && firebase deploy",
    "deploy:wizard": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "docs:pdf": "python scripts/build_pdf_documentation.py"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase-tools": "^15.32.0",
    "lucide-react": "^1.48.0",
    "oxlint": "^1.81.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
