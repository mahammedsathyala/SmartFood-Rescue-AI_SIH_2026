# Firebase Web App Configuration Example
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Maps Demo Integration (Optional - Frontend Map Rendering Only)
VITE_GOOGLE_MAPS_DEMO_KEY=your_google_maps_demo_key_here

# Google Maps Server Routes Key (Secret Server Key - Never prefix with VITE_)
GOOGLE_MAPS_SERVER_ROUTES_KEY=your_google_maps_server_routes_key_here