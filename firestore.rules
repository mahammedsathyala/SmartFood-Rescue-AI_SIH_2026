rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role-based permissions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isKitchenStaffOrAdmin() {
      return hasRole('Kitchen Staff') || hasRole('Administrator');
    }

    function isNgoPartner() {
      return hasRole('NGO Partner');
    }

    // Batches collection: Allow reads and writes only if request.auth != null
    match /batches/{batchId} {
      allow read, write: if request.auth != null;
    }

    // Admin collections: Allow reads and writes only if user role == 'Administrator'
    match /admin/{adminDoc=**} {
      allow read, write: if hasRole('Administrator');
    }

    // Settings collection: read authenticated, write only Administrator
    match /settings/{settingDoc} {
      allow read: if isAuthenticated();
      allow write: if hasRole('Administrator');
    }

    // Donations collection
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create, delete: if isKitchenStaffOrAdmin();
      allow update: if isKitchenStaffOrAdmin() || (
        isNgoPartner() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'donationStatus', 'updatedAt', 'notes'])
      );
    }

    // Delivery routes collection
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isKitchenStaffOrAdmin();
    }

    // Demand forecasts collection
    match /forecasts/{forecastId} {
      allow read: if isAuthenticated();
      allow write: if isKitchenStaffOrAdmin();
    }

    // NGO partners collection
    match /ngos/{ngoId} {
      allow read: if isAuthenticated();
      allow write: if isKitchenStaffOrAdmin() || (isNgoPartner() && request.auth.uid == ngoId);
    }

    // IoT Telemetry collection
    match /iot_data/{sensorId} {
      allow read: if isAuthenticated();
      allow write: if isKitchenStaffOrAdmin();
    }

    // AI Rescue Insights collection
    match /insights/{insightId} {
      allow read, write: if isAuthenticated();
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isKitchenStaffOrAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ESG Ledger collection
    match /esg_ledger/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Audit Log collection
    match /audit_log/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('Administrator');
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || hasRole('Administrator'));
    }

    // Default rule: Authenticated users can read documents
    match /{document=**} {
      allow read: if isAuthenticated();
    }
  }
}
